# SendGrid — usado por src/pages/api/contact.ts para enviar el formulario de contacto.
# Configurar como variables de entorno en el proyecto de Vercel (no en un archivo .env
# committeado). Nunca exponer SENDGRID_API_KEY con el prefijo PUBLIC_.

# API key de SendGrid (Settings > API Keys), con permiso de "Mail Send".
SENDGRID_API_KEY=

# Remitente verificado en SendGrid (Settings > Sender Authentication).
SENDGRID_FROM_EMAIL=

# Correo donde el equipo recibe las consultas del formulario.
SENDGRID_TO_EMAIL=Info@vtgipr.com
