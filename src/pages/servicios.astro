---
export const prerender = true;

import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import ServiceCard from '../components/ServiceCard.astro';
import SectionHeading from '../components/SectionHeading.astro';
import CTASection from '../components/CTASection.astro';
import { Blocks, Layers } from '@lucide/astro';
import { SERVICES_PAGE } from '../consts';
import ShieldIllustration from '../components/ShieldIllustration.astro';
---

<BaseLayout
  title="Servicios | Vector Technologies Group"
  description="Ofrecemos soluciones integrales en telecomunicaciones, seguridad y redes de computadoras para empresas."
>
  <PageHero
    eyebrow="Lo que hacemos"
    title="Servicios de Telecomunicaciones"
    description="Ofrecemos soluciones integrales en telecomunicaciones, seguridad y redes de computadoras para empresas."
  />

  <section class="bg-white py-20 sm:py-28">
    <div class="container-page grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {SERVICES_PAGE.map((service) => (
        <ServiceCard icon={service.icon} title={service.title} description={service.description} />
      ))}
    </div>
  </section>

  <section class="bg-white py-20 sm:py-28">
    <div class="container-page grid items-center gap-14 lg:grid-cols-2">
      <div class="fade-up w-full max-w-md justify-self-center">
        <ShieldIllustration />
      </div>
      <div class="fade-up flex flex-col gap-6">
        <span class="eyebrow text-(--color-primary)">Seguridad informática</span>
        <h2 class="text-3xl font-bold text-(--color-ink) sm:text-4xl">
          Protección de punta a punta para tu operación
        </h2>
        <p class="text-base leading-relaxed text-(--color-muted) sm:text-lg">
          Implementamos medidas de seguridad robustas para proteger la información, los sistemas
          y las operaciones de tu empresa frente a amenazas cibernéticas.
        </p>
      </div>
    </div>
  </section>

  <section class="bg-(--color-surface) py-20 sm:py-28">
    <div class="container-page flex flex-col gap-12">
      <SectionHeading
        eyebrow="Proyectos"
        title="Proyectos de Telecomunicaciones"
        description="Soluciones personalizadas en telecomunicaciones para empresas modernas."
      />
      <div class="grid gap-6 sm:grid-cols-2">
        <div class="fade-up card-surface flex flex-col gap-4 p-8">
          <Blocks class="h-6 w-6 text-(--color-primary)" aria-hidden="true" />
          <h3 class="text-lg font-bold text-(--color-ink)">Integración Completa</h3>
          <p class="text-sm leading-relaxed text-(--color-muted)">
            Sistemas integrados con marcas líderes en telecomunicaciones.
          </p>
        </div>
        <div class="fade-up card-surface flex flex-col gap-4 p-8">
          <Layers class="h-6 w-6 text-(--color-primary)" aria-hidden="true" />
          <h3 class="text-lg font-bold text-(--color-ink)">Casos de implementación</h3>
          <p class="text-sm leading-relaxed text-(--color-muted)">
            Ejemplos de implementación de servicios y productos en empresas.
          </p>
          <p class="text-xs italic text-(--color-muted)/80">
            Casos específicos disponibles previa verificación con el cliente.
          </p>
        </div>
      </div>
    </div>
  </section>

  <CTASection />
</BaseLayout>
