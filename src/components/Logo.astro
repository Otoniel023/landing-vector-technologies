---
import LogoMark from '../assets/logo-mark.svg';

interface Props {
  class?: string;
  style?: string;
}

const { class: className = '', style } = Astro.props;
---

<a
  href="/"
  aria-label="Vector Technologies Group — Inicio"
  class={`site-logo flex items-center gap-3 ${className}`}
  style={style}
>
  <img src={LogoMark.src} width="40" height="40" alt="" class="h-10 w-10 shrink-0 rounded-[12px]" />
  <span class="flex flex-col leading-none">
    <span class="logo-title font-heading text-lg font-extrabold tracking-tight">VECTOR</span>
    <span class="logo-subtitle text-[10px] font-semibold uppercase tracking-[0.2em]">
      Technologies Group
    </span>
  </span>
</a>

<style>
  .logo-title {
    color: var(--logo-title-color, var(--color-ink));
    transition: color 0.3s ease;
  }
  .logo-subtitle {
    color: var(--logo-subtitle-color, var(--color-muted));
    transition: color 0.3s ease;
  }
</style>
