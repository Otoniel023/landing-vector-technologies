---
import { ArrowRight } from '@lucide/astro';
import { ICONS, type IconName } from './icons';

interface Props {
  icon: IconName;
  title: string;
  description: string;
}

const { icon, title, description } = Astro.props;
const Icon = ICONS[icon];
---

<article class="fade-up card-surface group flex flex-col gap-5 p-7">
  <div class="flex h-12 w-12 items-center justify-center rounded-xl bg-(--color-secondary)/15">
    <Icon class="h-6 w-6 text-(--color-primary)" aria-hidden="true" />
  </div>
  <div class="flex flex-col gap-2">
    <h3 class="text-lg font-bold text-(--color-ink)">{title}</h3>
    <p class="text-sm leading-relaxed text-(--color-muted)">{description}</p>
  </div>
  <a
    href="/contacto"
    class="mt-auto inline-flex items-center gap-1.5 text-sm font-semibold text-(--color-primary) transition-colors group-hover:text-(--color-accent-600)"
  >
    Consultar disponibilidad
    <ArrowRight class="h-4 w-4 transition-transform group-hover:translate-x-1" aria-hidden="true" />
  </a>
</article>
