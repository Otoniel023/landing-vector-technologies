---
import { ICONS, type IconName } from './icons';

interface Props {
  index?: string;
  icon: IconName;
  title: string;
  description: string;
}

const { index, icon, title, description } = Astro.props;
const Icon = ICONS[icon];
---

<article class="fade-up card-surface flex flex-col gap-5 p-7">
  <div class="flex items-center justify-between">
    <div class="flex h-12 w-12 items-center justify-center rounded-xl bg-(--color-primary)/5">
      <Icon class="h-6 w-6 text-(--color-primary)" aria-hidden="true" />
    </div>
    {index && <span class="text-sm font-semibold text-(--color-accent-600)">{index}</span>}
  </div>
  <h3 class="text-lg font-bold text-(--color-ink)">{title}</h3>
  <p class="text-sm leading-relaxed text-(--color-muted)">{description}</p>
</article>
