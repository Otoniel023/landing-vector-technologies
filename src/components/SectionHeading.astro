---
interface Props {
  eyebrow?: string;
  title: string;
  description?: string;
  align?: 'left' | 'center';
  theme?: 'light' | 'dark';
}

const { eyebrow, title, description, align = 'left', theme = 'light' } = Astro.props;
const alignClass = align === 'center' ? 'text-center items-center mx-auto' : 'text-left items-start';
const titleColor = theme === 'dark' ? 'text-white' : 'text-(--color-ink)';
const descColor = theme === 'dark' ? 'text-white/70' : 'text-(--color-muted)';
const eyebrowColor = theme === 'dark' ? 'text-(--color-secondary)' : 'text-(--color-primary)';
---

<div class={`fade-up flex max-w-2xl flex-col gap-4 ${alignClass}`}>
  {eyebrow && <span class={`eyebrow ${eyebrowColor}`}>{eyebrow}</span>}
  <h2 class={`text-3xl font-bold sm:text-4xl ${titleColor}`}>{title}</h2>
  {description && <p class={`text-base leading-relaxed sm:text-lg ${descColor}`}>{description}</p>}
</div>
