---
import NetworkVisual from './NetworkVisual.astro';

interface Props {
  eyebrow: string;
  title: string;
  description?: string;
}
const { eyebrow, title, description } = Astro.props;
---

<section class="relative overflow-hidden bg-(--color-primary) pb-16 pt-40 sm:pb-20 sm:pt-44">
  <div class="pointer-events-none absolute inset-0 bg-[radial-gradient(circle_at_80%_0%,rgba(34,183,246,0.12),transparent_55%),radial-gradient(circle_at_0%_100%,rgba(10,102,194,0.14),transparent_55%)]"></div>
  <NetworkVisual class="pointer-events-none absolute -right-16 top-1/2 hidden w-[26rem] -translate-y-1/2 opacity-40 lg:block" />
  <div class="container-page relative z-10 flex flex-col gap-4">
    <span class="eyebrow text-(--color-secondary)">{eyebrow}</span>
    <h1 class="max-w-2xl text-4xl font-bold text-white sm:text-5xl">{title}</h1>
    {description && <p class="max-w-xl text-base text-white/70 sm:text-lg">{description}</p>}
  </div>
</section>
