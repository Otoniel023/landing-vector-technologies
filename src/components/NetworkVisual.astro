---
interface Props {
  class?: string;
}
const { class: className = '' } = Astro.props;
---

<div class={`network-visual relative ${className}`} aria-hidden="true">
  <div class="glow glow-yellow"></div>
  <div class="glow glow-green"></div>
  <svg viewBox="0 0 480 480" class="relative z-10 h-full w-full">
    <g stroke="#99D566" stroke-opacity="0.35" stroke-width="1.5" fill="none">
      <path d="M80 360 L200 260 L240 120 L360 90" />
      <path d="M200 260 L320 300 L400 220" />
      <path d="M240 120 L340 180 L400 220" />
      <path d="M80 360 L140 420" />
    </g>
    <g>
      <circle cx="80" cy="360" r="6" class="node node-a" fill="#FFD500" />
      <circle cx="200" cy="260" r="5" class="node node-b" fill="#99D566" />
      <circle cx="240" cy="120" r="7" class="node node-c" fill="#FFD500" />
      <circle cx="360" cy="90" r="5" class="node node-d" fill="#99D566" />
      <circle cx="320" cy="300" r="5" class="node node-e" fill="#99D566" />
      <circle cx="400" cy="220" r="6" class="node node-f" fill="#FFD500" />
      <circle cx="340" cy="180" r="4" class="node node-g" fill="#99D566" />
      <circle cx="140" cy="420" r="4" class="node node-h" fill="#99D566" />
    </g>
  </svg>
</div>

<style>
  .network-visual {
    aspect-ratio: 1 / 1;
  }

  .glow {
    position: absolute;
    border-radius: 999px;
    filter: blur(60px);
    opacity: 0.35;
  }

  .glow-yellow {
    top: 10%;
    right: 10%;
    width: 45%;
    height: 45%;
    background: #ffd500;
  }

  .glow-green {
    bottom: 5%;
    left: 5%;
    width: 50%;
    height: 50%;
    background: #99d566;
  }

  .node {
    transform-origin: center;
    animation: pulse 3.6s ease-in-out infinite;
  }

  .node-b, .node-e, .node-h { animation-delay: 0.6s; }
  .node-c, .node-f { animation-delay: 1.2s; }
  .node-d, .node-g { animation-delay: 1.8s; }

  @keyframes pulse {
    0%, 100% { opacity: 0.8; r: var(--r, 5); }
    50% { opacity: 1; transform: scale(1.3); }
  }

  @media (prefers-reduced-motion: reduce) {
    .node {
      animation: none;
    }
  }
</style>
