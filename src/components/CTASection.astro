---
import Button from './Button.astro';
import LogoMark from '../assets/logo-mark.png';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = '¿Necesitas una solución de telecomunicaciones para tu empresa?',
  description = 'Hablemos sobre tu proyecto.',
} = Astro.props;
---

<section class="relative overflow-hidden bg-(--color-primary) py-20 sm:py-24">
  <div class="pointer-events-none absolute inset-0 bg-[radial-gradient(circle_at_50%_120%,rgba(34,183,246,0.16),transparent_60%)]"></div>
  <img
    src={LogoMark.src}
    alt=""
    aria-hidden="true"
    class="pointer-events-none absolute -right-8 -top-10 h-56 w-auto opacity-[0.12] sm:h-72"
  />
  <div class="container-page fade-up relative z-10 flex flex-col items-center gap-6 text-center">
    <h2 class="max-w-2xl text-3xl font-bold text-white sm:text-4xl">{title}</h2>
    <p class="text-base text-white/70 sm:text-lg">{description}</p>
    <Button href="/contacto" variant="primary" class="mt-2">Contáctanos</Button>
  </div>
</section>
