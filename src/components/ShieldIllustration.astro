---
interface Props {
  class?: string;
}
const { class: className = '' } = Astro.props;
---

<div class={`shield-illustration relative ${className}`} aria-hidden="true">
  <div class="glow"></div>
  <svg viewBox="0 0 400 400" class="relative z-10 h-full w-full">
    <rect x="0.5" y="0.5" width="399" height="399" rx="28" fill="#EEF3F9" />

    <g stroke="#0A66C2" stroke-opacity="0.3" stroke-width="1.5" fill="none">
      <path d="M200 90 L120 60" />
      <path d="M200 130 L70 130" />
      <path d="M200 190 L60 220" />
      <path d="M200 90 L280 60" />
      <path d="M200 130 L330 130" />
      <path d="M200 190 L340 220" />
    </g>
    <g fill="#22B7F6">
      <circle cx="120" cy="60" r="4.5" class="pulse" />
      <circle cx="70" cy="130" r="4" class="pulse" style="animation-delay:.4s" />
      <circle cx="60" cy="220" r="4" class="pulse" style="animation-delay:.8s" />
      <circle cx="280" cy="60" r="4.5" class="pulse" style="animation-delay:.2s" />
      <circle cx="330" cy="130" r="4" class="pulse" style="animation-delay:.6s" />
      <circle cx="340" cy="220" r="4" class="pulse" style="animation-delay:1s" />
    </g>

    <path
      d="M200 78 L268 104 V196 C268 252 240 288 200 312 C160 288 132 252 132 196 V104 Z"
      fill="url(#shieldGradient)"
    />
    <path
      d="M200 78 L268 104 V196 C268 252 240 288 200 312 C160 288 132 252 132 196 V104 Z"
      fill="none"
      stroke="#22B7F6"
      stroke-opacity="0.4"
      stroke-width="2"
    />
    <path
      d="M168 198 L190 220 L236 172"
      fill="none"
      stroke="#EEF3F9"
      stroke-width="10"
      stroke-linecap="round"
      stroke-linejoin="round"
    />

    <defs>
      <linearGradient id="shieldGradient" x1="0" y1="0" x2="0" y2="1">
        <stop offset="0" stop-color="#0A66C2" />
        <stop offset="1" stop-color="#071B3D" />
      </linearGradient>
    </defs>
  </svg>
</div>

<style>
  .shield-illustration {
    aspect-ratio: 1 / 1;
  }

  .glow {
    position: absolute;
    top: 18%;
    left: 22%;
    width: 56%;
    height: 56%;
    background: #0a66c2;
    opacity: 0.16;
    filter: blur(55px);
    border-radius: 999px;
  }

  .pulse {
    animation: shield-pulse 3s ease-in-out infinite;
  }

  @keyframes shield-pulse {
    0%, 100% { opacity: 0.5; }
    50% { opacity: 1; }
  }

  @media (prefers-reduced-motion: reduce) {
    .pulse {
      animation: none;
    }
  }
</style>
