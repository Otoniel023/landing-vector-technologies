---
import { Menu, X } from '@lucide/astro';
import Logo from './Logo.astro';
import Button from './Button.astro';
import { NAV_LINKS } from '../consts';

const currentPath = Astro.url.pathname.replace(/\/$/, '') || '/';
---

<header id="site-header" class="fixed inset-x-0 top-0 z-50 transition-all duration-300" data-state="top">
  <div class="container-page flex h-20 items-center justify-between">
    <Logo />

    <nav class="hidden items-center gap-8 md:flex" aria-label="Navegación principal">
      {NAV_LINKS.map((link) => {
        const active = currentPath === link.href;
        return (
          <a
            href={link.href}
            aria-current={active ? 'page' : undefined}
            class:list={['header-link relative text-sm font-medium', active && 'header-link-active']}
          >
            {link.label}
          </a>
        );
      })}
    </nav>

    <div class="hidden md:block">
      <Button href="/contacto" variant="primary">Contáctanos</Button>
    </div>

    <button
      id="menu-toggle"
      type="button"
      class="header-link flex h-11 w-11 items-center justify-center rounded-full md:hidden"
      aria-label="Abrir menú"
      aria-expanded="false"
      aria-controls="mobile-drawer"
    >
      <Menu id="icon-menu" class="h-6 w-6" />
      <X id="icon-close" class="hidden h-6 w-6" />
    </button>
  </div>

  <div
    id="mobile-drawer"
    class="fixed inset-x-0 top-20 z-40 origin-top scale-y-0 border-t border-black/5 bg-white opacity-0 shadow-xl transition-all duration-200 md:hidden"
  >
    <nav class="container-page flex flex-col gap-1 py-6" aria-label="Navegación móvil">
      {NAV_LINKS.map((link) => (
        <a
          href={link.href}
          class="rounded-xl px-4 py-3 text-base font-medium text-(--color-ink) transition-colors hover:bg-(--color-surface)"
        >
          {link.label}
        </a>
      ))}
      <Button href="/contacto" variant="primary" class="mt-3">Contáctanos</Button>
    </nav>
  </div>
</header>

<script>
  const header = document.getElementById('site-header');
  const menuToggle = document.getElementById('menu-toggle');
  const drawer = document.getElementById('mobile-drawer');
  const iconMenu = document.getElementById('icon-menu');
  const iconClose = document.getElementById('icon-close');

  let drawerOpen = false;

  const applyState = () => {
    if (!header) return;
    const scrolled = window.scrollY > 24;
    header.dataset.state = scrolled || drawerOpen ? 'scrolled' : 'top';
    header.classList.toggle('bg-white/90', scrolled || drawerOpen);
    header.classList.toggle('backdrop-blur-md', scrolled || drawerOpen);
    header.classList.toggle('shadow-sm', scrolled || drawerOpen);
  };

  window.addEventListener('scroll', applyState, { passive: true });
  applyState();

  menuToggle?.addEventListener('click', () => {
    drawerOpen = !drawerOpen;
    drawer?.classList.toggle('scale-y-0', !drawerOpen);
    drawer?.classList.toggle('opacity-0', !drawerOpen);
    iconMenu?.classList.toggle('hidden', drawerOpen);
    iconClose?.classList.toggle('hidden', !drawerOpen);
    menuToggle.setAttribute('aria-expanded', String(drawerOpen));
    menuToggle.setAttribute('aria-label', drawerOpen ? 'Cerrar menú' : 'Abrir menú');
    applyState();
  });
</script>

<style>
  #site-header {
    --logo-title-color: #ffffff;
    --logo-subtitle-color: rgba(255, 255, 255, 0.72);
    --header-link-color: #ffffff;
  }

  #site-header[data-state='scrolled'] {
    --logo-title-color: var(--color-ink);
    --logo-subtitle-color: var(--color-muted);
    --header-link-color: var(--color-ink);
  }

  .header-link {
    color: var(--header-link-color, #fff);
    transition: color 0.3s ease;
  }

  .header-link-active {
    color: var(--color-accent) !important;
  }

  .header-link-active::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: -6px;
    height: 2px;
    background: var(--color-accent);
    border-radius: 2px;
  }
</style>
