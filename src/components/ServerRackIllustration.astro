---
interface Props {
  class?: string;
}
const { class: className = '' } = Astro.props;

const units = [
  { y: 60, leds: ['on', 'on', 'off'] },
  { y: 118, leds: ['on', 'off', 'off'] },
  { y: 176, leds: ['off', 'on', 'on'] },
  { y: 234, leds: ['on', 'on', 'off'] },
  { y: 292, leds: ['off', 'off', 'on'] },
] as const;
---

<div class={`server-rack relative ${className}`} aria-hidden="true">
  <div class="glow"></div>
  <svg viewBox="0 0 400 400" class="relative z-10 h-full w-full">
    <rect x="0.5" y="0.5" width="399" height="399" rx="28" fill="#EEF3F9" />

    <g stroke="#0A66C2" stroke-opacity="0.25" stroke-width="1.5" fill="none">
      <path d="M300 350 C 340 350, 350 340, 350 300" />
      <path d="M300 330 C 325 330, 335 320, 335 300" />
    </g>
    <circle cx="350" cy="300" r="5" fill="#22B7F6" class="pulse" />
    <circle cx="335" cy="300" r="4" fill="#0A66C2" class="pulse" style="animation-delay:.5s" />

    <rect x="120" y="40" width="160" height="320" rx="16" fill="#071B3D" />
    <rect x="120" y="40" width="160" height="320" rx="16" fill="url(#rackGradient)" opacity="0.5" />

    {units.map((unit) => (
      <g>
        <rect x="134" y={unit.y} width="132" height="42" rx="8" fill="#0D2A54" />
        <rect x="146" y={unit.y + 15} width="60" height="4" rx="2" fill="#3E5C8A" />
        <rect x="146" y={unit.y + 24} width="40" height="4" rx="2" fill="#3E5C8A" />
        {unit.leds.map((state, i) => (
          <circle
            cx={214 + i * 14}
            cy={unit.y + 21}
            r="3.5"
            fill={state === 'on' ? '#22B7F6' : '#2C4A78'}
            class={state === 'on' ? 'pulse' : ''}
            style={state === 'on' ? `animation-delay:${i * 0.4}s` : undefined}
          />
        ))}
      </g>
    ))}

    <defs>
      <linearGradient id="rackGradient" x1="0" y1="0" x2="1" y2="1">
        <stop offset="0" stop-color="#22B7F6" stop-opacity="0.25" />
        <stop offset="1" stop-color="#0A66C2" stop-opacity="0" />
      </linearGradient>
    </defs>
  </svg>
</div>

<style>
  .server-rack {
    aspect-ratio: 1 / 1;
  }

  .glow {
    position: absolute;
    top: 15%;
    left: 20%;
    width: 60%;
    height: 60%;
    background: #22b7f6;
    opacity: 0.14;
    filter: blur(50px);
    border-radius: 999px;
  }

  .pulse {
    animation: rack-pulse 2.8s ease-in-out infinite;
    transform-origin: center;
  }

  @keyframes rack-pulse {
    0%, 100% { opacity: 0.55; }
    50% { opacity: 1; }
  }

  @media (prefers-reduced-motion: reduce) {
    .pulse {
      animation: none;
    }
  }
</style>
